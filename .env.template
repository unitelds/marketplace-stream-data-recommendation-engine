# Copy this file to .env and fill in real values. Never commit .env.

# ── Environment ───────────────────────────────────────────────────────────────
TOKI_ENV=production            # production | staging

# ── Oracle (engagement event source) ──────────────────────────────────────────
ORACLE_USERNAME=oracle_username
ORACLE_PASSWORD=password
ORACLE_HOSTNAME=hostname
ORACLE_PORT=1521
ORACLE_SERVICE=DWH

# ── Trino ─────────────────────────────────────────────────────────────────────
TRINO_USERNAME=username
TRINO_PASSWORD=password
TRINO_HOSTNAME=url
TRINO_PORT=8443
TRINO_SERVICE=iceberg

# ── PostgreSQL (product catalog) ──────────────────────────────────────────────
TOKI_DB_USER=marketplace_user
TOKI_DB_PASSWORD=password
TOKI_DB_HOST=10.21.67.188
TOKI_DB_PORT=5432
TOKI_DB_NAME=postgres

# ── INBOUND FEED 1: Marketplace Catalog API (handset-shop feed) ───────────────
# GET {url}/{account_id} → {"userId", "taxonRecommendations": {slug: [pid, ...]}}
# Six device taxons: handset · tablet · watch · earphones · accessory · cpe.
TOKI_CATALOG_FEED_URL=http://10.21.60.94:9000/marketplace
TOKI_CATALOG_FEED_TIMEOUT=1.5
TOKI_CATALOG_FEED_CACHE_TTL=3600

# ── INBOUND FEED 2: TOKI Shop Feed (legacy demographic engine) ────────────────
# GET {url}/{account_id} → same envelope, full ~80-taxon catalogue.
# Answers for every account, so it doubles as the cold-start bridge.
TOKI_SHOP_FEED_URL=http://10.21.60.94:8018/api/recommendations
TOKI_SHOP_FEED_TIMEOUT=1.5
TOKI_SHOP_FEED_CACHE_TTL=600

# ── OUTBOUND: recommendation delivery to the marketplace ──────────────────────
# production → https://marketplace.toki.mn/ms/catalogue/v1/recommendation
# staging    → https://staging-marketplace.toki.mn/ms/catalogue/v1/recommendation
# REQUIRED: both hosts answer 401 {"message":"Authentication required"} without
# a bearer token, so delivery silently fails until this is set.
TOKI_MARKETPLACE_PUSH_URL=
TOKI_MARKETPLACE_PUSH_TOKEN=
TOKI_MARKETPLACE_PUSH_TIMEOUT=5.0
TOKI_MARKETPLACE_PUSH_RETRIES=2

# ── Scheduled top-users push ──────────────────────────────────────────────────
# Off by default pending confirmation of the marketplace payload contract.
TOKI_PUSH_ENABLED=false
TOKI_PUSH_TOP_USERS=1000
TOKI_PUSH_INTERVAL=600
TOKI_PUSH_BATCH_SIZE=50

# ── Inbound API authentication ────────────────────────────────────────────────
# Off by default. Turn on only once marketplace.toki.mn sends X-API-Key,
# otherwise the event stream will start being rejected with 401.
TOKI_AUTH_ENABLED=false
TOKI_API_KEYS=

# ── Misc ──────────────────────────────────────────────────────────────────────
TOKI_LOG_LEVEL=INFO
LOG_LEVEL=INFO
